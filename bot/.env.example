# Telegram Bot Token (dari @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# ML
CONFIDENCE_THRESHOLD=0.5

# Mode: polling | webhook
MODE=polling

# Webhook (hanya jika MODE=webhook)
# WEBHOOK_URL=https://domainkamu.com/webhook
# WEBHOOK_SECRET=rahasia123

# Supabase (simpan laporan ke database)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIs...

# Admin Telegram Chat ID (notifikasi BAHAYA)
# ADMIN_CHAT_ID=-1001234567890

# Admin user IDs (akses /stats, dipisah koma)
# ADMIN_IDS=123456789,987654321

# Rate limiting
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW=60

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
