<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Perhatikan bagian parent ini sudah diubah ke MaterialComponents -->
    <style name="Theme.RetakId" parent="Theme.MaterialComponents.Light.NoActionBar">

        <!-- Primary Brand Color (Tidak pakai awalan android:) -->
        <item name="colorPrimary">@color/green_primary</item>
        <item name="colorPrimaryVariant">@color/green_dark</item>
        <item name="colorOnPrimary">@color/surface_white</item>

        <!-- Secondary Brand Color -->
        <item name="colorSecondary">@color/brown_secondary</item>
        <item name="colorSecondaryVariant">@color/brown_dark</item>
        <item name="colorOnSecondary">@color/surface_white</item>

        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/background_light</item>
        <item name="colorSurface">@color/surface_white</item>

        <!-- Text Colors -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>

        <!-- Error / Bahaya -->
        <item name="colorError">@color/status_bahaya</item>

    </style>
</resources>