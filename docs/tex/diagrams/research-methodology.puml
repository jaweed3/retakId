@startuml
skinparam backgroundColor White
skinparam ArrowColor #2c3e50
skinparam ArrowThickness 2
skinparam activityBorderColor #1a5276
skinparam activityBackgroundColor #eaf2f8
skinparam activityBorderThickness 2
skinparam activityFontSize 13
skinparam activityFontStyle bold
skinparam activityShape roundRect
skinparam defaultTextColor #1a1a1a
skinparam partitionBorderColor #2c3e50
skinparam partitionFontStyle bold

partition "Dataset" #f0f8ff {
  :Image Collection;
  :Triage & Validation;
  :Stratified Split;
}

partition "Model Development" #f5faf5 {
  :MobileNetV2\nTransfer Learning;
  :Fine-tuning;
  :INT8 Quantization;
}

partition "System Implementation" #fff5f5 {
  :3 Platform Clients\n(Android, Web, Telegram);
  :Backend +\nEdge Functions;
  :Risk Engine\nIntegration;
}

partition "Evaluation" #f5f0ff {
  :Performance\nMetrics;
  :Quantization\nAgreement;
  :Delta OTA\nValidation;
}

@enduml
