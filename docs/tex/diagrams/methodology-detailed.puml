@startuml
skinparam backgroundColor White
skinparam activityBorderColor #1a5276
skinparam activityBackgroundColor #eaf2f8
skinparam activityBorderThickness 2
skinparam activityFontSize 11
skinparam activityFontStyle bold
skinparam activityShape roundRect
skinparam defaultTextColor #1a1a1a
skinparam ArrowColor #2c3e50
skinparam ArrowThickness 2
skinparam swimlaneBorderColor #2c3e50
skinparam swimlaneFontSize 13
skinparam swimlaneFontStyle bold

|Dataset|
:Image Crawling\n70+ keywords;
:Validation & Triage\n3 classes, blur reject, dedup;
:Stratified Split\n70/15/15, DVC versioned;

|Model Development|
:MobileNetV2\nImageNet, 224x224;
:Fine-tuning\n24/154 layers, Adam 5e-6;
:INT8 Quantization\n100 samples, 2.6MB, 7 safety gates;

|System Implementation|
:Android + Web + Telegram\n3 platforms, same pipeline;
:Supabase Backend\nPG, edge functions, storage;
:Multi-Factor Risk Engine\nML(50%)+Slope+Rain+Elev+Soil;

|Evaluation|
:Model Metrics\n84.9% acc, 0.83 F1;
:Quantization Agreement\n93.75% vs FP32;
:Delta OTA\n98.2% bandwidth saving;
@enduml
