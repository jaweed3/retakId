@startuml
left to right direction
skinparam backgroundColor White
skinparam ArrowColor #2c3e50
skinparam ArrowThickness 2
skinparam componentBorderColor #1a5276
skinparam componentBackgroundColor #eaf2f8
skinparam componentBorderThickness 2
skinparam componentFontSize 11
skinparam defaultTextColor #1a1a1a
skinparam rectangleBorderColor #2c3e50
skinparam rectangleBackgroundColor #f8f9fa
skinparam rectangleFontStyle bold
skinparam rectangleFontSize 13

component "Dataset" as d {
  [Crawling 70+ keywords]
  [Triage AMAN / WASPADA / BAHAYA]
  [Validation + Split 70/15/15]
}

component "Model\nDevelopment" as m {
  [MobileNetV2 224x224]
  [Fine-tuning 24 layers]
  [INT8 PTQ 2.6 MB]
}

component "System\nImplementation" as s {
  [Android + Web + Telegram]
  [Supabase Backend]
  [Risk Engine ML + Env]
}

component "Evaluation" as e {
  [Accuracy 84.9%, F1 0.83]
  [INT8 Agreement 93.75%]
  [Delta OTA 98.2%]
}

d --> m
m --> s
s --> e
@enduml
